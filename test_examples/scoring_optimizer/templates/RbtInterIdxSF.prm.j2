{# scoring_optimizer/templates/RbtInterIdxSF.prm.j2 #}
RBT_PARAMETER_FILE_V1.00
TITLE Optimized intermolecular scoring function

SECTION CONST
    SCORING_FUNCTION    RbtConstSF
    SOLVENT_PENALTY     0.37
    WEIGHT              {{ "%.4f" % const_weight }}
END_SECTION

SECTION ROT
    SCORING_FUNCTION    RbtRotSF
    WEIGHT              {{ "%.4f" % rot_weight }}
END_SECTION

SECTION SETUP_POLAR
    SCORING_FUNCTION    RbtSetupPolarSF
    RADIUS              5.0
    NORM                25
    POWER               0.5
    CHGFACTOR           0.5
    GUANFACTOR          0.5
END_SECTION

SECTION POLAR
    SCORING_FUNCTION    RbtPolarIdxSF
    WEIGHT              {{ "%.4f" % polar_weight }}
    R12FACTOR           1.0
    R12INCR             0.05
    DR12MIN             0.25
    DR12MAX             0.6
    A1                  180.0
    DA1MIN              30.0
    DA1MAX              80.0
    A2                  180.0
    DA2MIN              60.0
    DA2MAX              100.0
    INCMETAL            TRUE
    INCHBD              TRUE
    INCHBA              TRUE
    INCGUAN             TRUE
    GUAN_PLANE          TRUE
    ABS_DR12            TRUE
    GRIDSTEP            0.5
    RANGE               5.31
    INCR                3.36
    ATTR                TRUE
    LP_OSP2             TRUE
    LP_PHI              45
    LP_DPHIMIN          15
    LP_DPHIMAX          30
    LP_DTHETAMIN        20
    LP_DTHETAMAX        60
END_SECTION

SECTION REPUL
    SCORING_FUNCTION    RbtPolarIdxSF
    WEIGHT              {{ "%.4f" % repul_weight }}
    R12FACTOR           1.0
    R12INCR             0.6
    DR12MIN             0.25
    DR12MAX             1.1
    A1                  180.0
    DA1MIN              30.0
    DA1MAX              60.0
    A2                  180.0
    DA2MIN              30.0
    DA2MAX              60.0
    INCMETAL            TRUE
    INCHBD              TRUE
    INCHBA              TRUE
    INCGUAN             TRUE
    GUAN_PLANE          FALSE
    ABS_DR12            FALSE
    GRIDSTEP            0.5
    RANGE               5.32
    INCR                3.51
    ATTR                FALSE
    LP_OSP2             FALSE
END_SECTION

SECTION VDW
    SCORING_FUNCTION    RbtVdwIdxSF
    WEIGHT              {{ "%.4f" % vdw_weight }}
    USE_4_8             FALSE
    USE_TRIPOS          FALSE
    RMAX                1.5
    ECUT                120.0
    E0                  1.5
    FAST_SOLVENT        TRUE
END_SECTION
